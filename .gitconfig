# This is Git's per-user configuration file.
[user]
	name = Brian R. Bondy
	email = netzen@gmail.com
	signingkey = ssh-rsa  netzen@gmail.com
[push]
	default = current
[alias]
	incoming = "!git remote update -p; git log ..@{u}"
	outgoing = log @{u}..
	su = git submodule update --init --recursive
	tags = git log --tags --simplify-by-decoration --pretty="format:%ai %d"
	unstage = reset --
	diffbase = diff origin/HEAD...
	amendnv = commit --amend --no-verify
	amendlast = !git add . && git commit --amend --no-verify --no-edit
	famendlast = !npm run format && git add . && git commit --amend --no-verify --no-edit
	recent-branches = for-each-ref --sort=-creatordate --format=\"%(refname:short) - %(creatordate)\" refs/heads/
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[secrets]
# These are generated from:
# git clone git@github.com:awslabs/git-secrets.git
# git-secrets --register-aws --global
#
# Manually scan with:
# git-secrets --scan -r .
	providers = git secrets --aws-provider
	patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
	patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
	patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
	allowed = AKIAIOSFODNN7EXAMPLE
	allowed = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
[init]
# To init, run this:
# git secrets --install
# git secrets --install ~/.git-templates/git-secrets
# git init --template ~/.git-templates/git-secrets
	templateDir =  $HOME/.git-templates/git-secrets
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg]
	format = ssh
	program = gpg

